# Copy this file to .env and fill in the two values from your Supabase
# project's Settings -> API page. Both are safe to ship in client code —
# the anon key is meant to be public; real protection comes from the
# row-level-security policies in supabase/migrations/0001_init.sql.
#
# The EXPO_PUBLIC_ prefix is required: Expo only inlines env vars into the
# client bundle when they're prefixed this way (see src/lib/supabase.ts).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
